# Dairy Farm Explorer Configuration
# Copy this file to .env and fill in your values

# App Configuration
VITE_APP_TITLE=Real California Milk: The Farm-to-Flavor Journey
VITE_APP_DESCRIPTION=An interactive journey through the California dairy supply chain

# API Configuration (if needed)
VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT=30000

# Analytics & Tracking
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=

# Brand Assets
VITE_BRAND_PRIMARY_COLOR=#1a7a3c
VITE_BRAND_SECONDARY_COLOR=#f5b21e

# Video Assets
VITE_INTRO_VIDEO_PATH=assets/california-intro.mp4

# Environment
NODE_ENV=development
